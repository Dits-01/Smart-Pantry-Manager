<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_accent_color"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/radio_group_accent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <RadioButton
                android:id="@+id/radio_blue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_accent_color_blue"
                android:checked="true"
                app:buttonTint="@color/accent_blue" />

            <RadioButton
                android:id="@+id/radio_indigo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_accent_color_indigo"
                app:buttonTint="@color/accent_indigo" />

            <RadioButton
                android:id="@+id/radio_teal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_accent_color_teal"
                app:buttonTint="@color/accent_teal" />

            <RadioButton
                android:id="@+id/radio_purple"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_accent_color_purple"
                app:buttonTint="@color/accent_purple" />

            <RadioButton
                android:id="@+id/radio_orange"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_accent_color_orange"
                app:buttonTint="@color/accent_orange" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_preferred_unit_system"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/radio_group_unit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <RadioButton
                android:id="@+id/radio_unit_metric"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_preferred_unit_system_metric"
                android:layout_marginEnd="16dp"
                android:checked="true" />

            <RadioButton
                android:id="@+id/radio_unit_imperial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_preferred_unit_system_imperial" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_theme_mode"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_dark_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_theme_mode_dark_mode"
            android:textSize="16sp"
            android:paddingVertical="8dp" />

    </LinearLayout>

</ScrollView>
