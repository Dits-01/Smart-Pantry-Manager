<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.SmartPantryManager" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color (Default Blue Accent) -->
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorPrimaryVariant">@color/accent_blue_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary color -->
        <item name="colorSecondary">@color/accent_teal</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Background & Surface colors for Gray Theme -->
        <item name="android:windowBackground">@color/gray_light</item>
        <item name="colorSurface">@color/gray_surface</item>

        <!-- Status bar color -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>

    <style name="Theme.SmartPantryManager.Indigo" parent="Theme.SmartPantryManager">
        <item name="colorPrimary">@color/accent_indigo</item>
        <item name="colorPrimaryVariant">@color/accent_indigo</item>
    </style>

    <style name="Theme.SmartPantryManager.Teal" parent="Theme.SmartPantryManager">
        <item name="colorPrimary">@color/accent_teal</item>
        <item name="colorPrimaryVariant">@color/accent_teal</item>
    </style>

    <style name="Theme.SmartPantryManager.Purple" parent="Theme.SmartPantryManager">
        <item name="colorPrimary">@color/accent_purple</item>
        <item name="colorPrimaryVariant">@color/accent_purple</item>
    </style>

    <style name="Theme.SmartPantryManager.Orange" parent="Theme.SmartPantryManager">
        <item name="colorPrimary">@color/accent_orange</item>
        <item name="colorPrimaryVariant">@color/accent_orange</item>
    </style>
</resources>